# Portfolio AI / LLM bake-off (TODO 9)
# Copy to .env and fill values. Never commit real keys.

# Active default (used by generateGroundedAnswer when not overridden)
AI_PROVIDER=openai_compatible
AI_MODEL=gpt-4o-mini
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1

# Optional named providers for bake-off (comma-separated provider:model)
# Examples:
#   LLM_BAKEOFF_MODELS=openai_compatible:gpt-4o-mini,groq:llama-3.1-8b-instant,deepseek:deepseek-chat,local:grounded_composer
LLM_BAKEOFF_MODELS=local:grounded_composer,local:extractive,local:cautious

# Provider-specific keys (used when AI_PROVIDER matches or bake-off expands aliases)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1

DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com

MISTRAL_API_KEY=
MISTRAL_BASE_URL=https://api.mistral.ai/v1

OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash-lite

# Shared generation defaults
AI_TEMPERATURE=0.2
AI_MAX_TOKENS=400

# Agent runtime (TODO 10) — primary + optional failover
# AI_PROVIDER / AI_MODEL are the primary. Fallback only on provider errors (not unsupported answers).
AI_FALLBACK_PROVIDER=local
AI_FALLBACK_MODEL=grounded_composer

# Dev agent bridge (TODO 11) — Node process only; never put cloud keys in REACT_APP_*
AGENT_BRIDGE_PORT=8787
AGENT_BRIDGE_HOST=127.0.0.1

# Frontend agent transport (public URL / flags only — never API keys)
REACT_APP_AGENT_MODE=split
# Local: leave GENERATE_URL unset → CRA proxy /api/agent → npm run agent:bridge
# Production: set via .env.production / GitHub Actions (jq404 execute-api URL)
# REACT_APP_AGENT_GENERATE_URL=https://lm0utr1vmi.execute-api.ap-southeast-2.amazonaws.com
# REACT_APP_AGENT_ENABLED=true
# REACT_APP_AGENT_DEBUG=true
